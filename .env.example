NODE_ENV=development
PORT=5000

# MongoDB Atlas (or local) connection string, including the database name.
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/aidbridge?retryWrites=true&w=majority

# Generate a real value, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The server refuses to start while this is still the placeholder or shorter than 32 characters.
JWT_SECRET=replace-with-a-random-string-of-at-least-32-chars
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# Allowed browser origin for CORS (the React client).
CLIENT_URL=http://localhost:5173

# Added in later commits (not read yet):
#   commit 3  EMAIL_USER, EMAIL_PASS       Gmail sender + app password for reset / broadcast mail
#   commit 4  CLOUDINARY_URL               cloudinary://<api_key>:<api_secret>@<cloud_name>
#   commit 10 ADMIN_EMAIL, ADMIN_PASSWORD  demo admin created by `npm run seed`
