NODE_ENV=development
PORT=5000

# MongoDB Atlas (or local) connection string, including the database name.
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/aidbridge?retryWrites=true&w=majority

# Generate a real value, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The server refuses to start while this is still the placeholder or shorter than 32 characters.
JWT_SECRET=replace-with-a-random-string-of-at-least-32-chars
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# Allowed browser origin for CORS (the React client).
CLIENT_URL=http://localhost:5173

# Gmail sender for password-reset and emergency-broadcast mail. EMAIL_PASS must be a Google "App
# password" (needs 2-step verification), not your normal password. Set both or neither: with neither,
# development prints the reset link to the server console and production refuses to start.
EMAIL_USER=
EMAIL_PASS=

# Cloudinary account for SOS photos/videos: Cloudinary dashboard -> "API Environment variable"
# (cloudinary://<api_key>:<api_secret>@<cloud_name>). Optional in development: without it everything
# else works and PUT /sos/:id/media answers 503. Required in production.
CLOUDINARY_URL=

# First admin, created once by `npm run seed` (then delete scripts/seed.ts and ADMIN_PASSWORD).
# The password needs 8+ characters with a letter and a number. Every later admin or NGO is created by
# an admin through the API, so these are not needed after the first run.
ADMIN_NAME=Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
